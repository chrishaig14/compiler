typeclass Addable[t] {
    fun add() -> Integer
}

class Foo {
    i: Integer
}

instance Addable[Foo] {
    fun add() -> Integer {
        return 7
    }
}

fun baba(x: t) -> Integer where t::Addable {
    var r = x.add()
    return 0
}

typeclass Stringable[t] {
    fun to_string() -> String
}

fun list_to_string(l: List[t]) -> String where t::Stringable {
    var s = "["
    for x @ l {
        s += x.to_string() + ", "
    }
    s += "]"
    return s
}

instance Stringable[Foo] {
    fun to_string() -> String {
        return "Helloo!"
    }
}

fun main() -> Integer {
    var f : List[Foo] = [#Foo(9), #Foo(100)]
    print(list_to_string(f))
    return 0
}