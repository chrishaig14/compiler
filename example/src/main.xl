class Foo {
    x: Integer
}

fun get_integer_or_string() -> Union[Integer, String]{
    return 3
}

fun main() -> Integer {
    var t = get_integer_or_string()
    var w = ""
    match t {
        x: Integer {
            w = x.str()
        }
        y: String {
            w = y
        }
    }
    print(w)
    return 2
}