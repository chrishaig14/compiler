typeclass Addable[t] {
    fun add(x:t) -> t
}

fun add_list(l: List[t], zero: t) -> t where t::Addable{
    var r = zero
    for x @ l {
        r = r.add(x)
    }
    return r
}

class Wrap {
    i: Integer
}

instance Addable[Wrap] {
    fun add(other: Wrap) -> Wrap {
        return #Wrap(this.i + other.i)
    }
}

fun main() -> Integer {
    var l = [#Wrap(11),#Wrap(9)]
    var r = add_list(l, #Wrap(5))
    print(r.i.str())
    return 0
}