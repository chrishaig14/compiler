typeclass Addable[t] {
    fun add(x:t) -> t
}
typeclass Stringable[t] {
    fun to_string()->String
}
fun add_list(l: List[t], zero: t) -> t where t::(Addable,Stringable) {
    var r = zero
    for x @ l {
        r = r.add(x)
        print(r.to_string())
    }
    return r
}

class Wrap {
    i: Integer
}

instance Stringable[Wrap] {
    fun to_string() -> String {
        return "Wrap(" + this.i.str() + ")"
    }
}

instance Addable[Wrap] {
    fun add(other: Wrap) -> Wrap {
        return #Wrap(this.i + other.i)
    }
}

fun main() -> Integer {
    var l = [#Wrap(11),#Wrap(9)]
    var r = add_list(l, #Wrap(5))
    print(r.i.str())
    return 0
}