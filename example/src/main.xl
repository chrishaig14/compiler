typeclass Stringable[t] {
    fun as_string() -> String
}

class MyFoo {
    str: String
}

instance Stringable[MyFoo] {
    fun as_string() -> String {
        return "Hello my friend: " + this.str
    }
}

fun get_string(a: t) -> String where t:: Stringable {
    return "the string is " + a.as_string()
}

fun main() -> Integer {
    var x : Integer = "5"
    var my_foo = #MyFoo("Hello Chris!")
    print(get_string("Hello"))
    return 0
}