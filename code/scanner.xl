import core.Integer
import core.print
import core.String
import core.List
import core.Boolean
import core.range
import core.Dict

enum TokenType {
    For, Class, Enum, Var, Import, If, Else, Start, EOF, Id, Special, OpenParen, CloseParen, OpenCurly, CloseCurly, Assign, Number, Semicolon, Colon, Comma, KwVar, KwFun
}

class Token {
    str: String
    type: TokenType
}

fun is_letter(c: String)->Boolean {
    return ["a", "b","c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z"].has(c)
}

fun char_in_string(c: String, s: String) -> Boolean {
    for i @ range(0, 1, s.len()) {
        if c == s[i] {
            return true
        }
    }
    return false
}

fun map_special(c: String)->TokenType{
    var m = {"(":TokenType.OpenParen};
    m[")"] = TokenType.CloseParen
    m["{"] = TokenType.OpenCurly
    m["}"] = TokenType.CloseCurly
    m["="] = TokenType.Assign
    m[";"] = TokenType.Semicolon
    m[":"] = TokenType.Colon
    m[","] = TokenType.Comma
    if m.has(c) {
        return m[c]
    }
    return TokenType.Id
}

fun map_keyword(c: String)->TokenType{
    var kw_map = {"var": TokenType.KwVar, "fun":TokenType.KwFun};
    if kw_map.has(c) {
        return kw_map[c]
    }
    return TokenType.Id
}

fun map_token_to_string(tok: TokenType) -> String {
    var m = {TokenType.OpenParen:"OpenParen"};
    m[TokenType.CloseParen] = "CloseParen"
    m[TokenType.OpenCurly] = "OpenCurly"
    m[TokenType.CloseCurly] = "CloseCurly"
    m[TokenType.Assign] = "Assign"
    m[TokenType.Comma] = "Comma"
    m[TokenType.Colon] = "Colon"
    m[TokenType.Semicolon] = "Semicolon"
    m[TokenType.KwVar] = "KwVar"
    m[TokenType.KwFun] = "KwFun"
    m[TokenType.Id] = "Id"
    m[TokenType.Number] = "Number"
    if m.has(tok) {
        return m[tok]
    }
    return "Unknown"
}

class Scanner {
    text: String
    cursor: Integer
    c: String
    tokens: List[Token]
    token: Token
    static fun init(text: String)->Scanner {
        return #Scanner(text, 0-1, "", []::Token, #Token("",TokenType.Start))
    }
    fun advance(){
        this.cursor = this.cursor + 1
        if this.cursor >= this.text.len() {
            return
        }
        this.c = this.text[this.cursor]
    }
    fun skip_spaces(){
        while this.c == " " {
            this.advance()
        }
    }
    fun scan() -> Integer {
        _ = this.advance()
        while this.cursor < this.text.len() {
            _ = this.skip_spaces()
            if is_letter(this.c) {
                _ = this.scan_id_or_kw()
            } elif (char_in_string(this.c, "(){}=;,:")) {
                this.token = #Token(this.c,map_special(this.c))
                _ = this.advance()
            } elif (char_in_string(this.c, "1234567890")){
                _ = this.scan_number()
            }
            else {
                print("Don't know what to do with character '" + this.c + "'")
                return 1
            }
            this.tokens.push(this.token)
            print(this.token.str)
        }
        return 0
    }
    fun scan_number(){
        var s = this.c
        _ = this.advance()
        while char_in_string(this.c, "1234567890") {
            s += this.c
            _ = this.advance()
        }
        this.token = #Token(s, TokenType.Number)
    }
    fun scan_id_or_kw(){
        var s = this.c
        _ = this.advance()
        while is_letter(this.c) {
            s += this.c
            _ = this.advance()
        }
        var token_type = map_keyword(s)
        this.token = #Token(s, token_type)
    }
}
