//import .core.Integer
//import .core.Boolean

class Socket {
    static fun new(domain: SocketDomain, type: SocketType) -> Socket {}
    fun accept() -> Socket {}
    fun recv(n: Integer) -> String {}
    fun listen(n: Integer) {}
    fun bind(port: Integer) -> Boolean {}
    fun send(msg: String) -> Integer {}
}

enum SocketDomain {AF_INET, AF_INET6}
enum SocketType {SOCK_STREAM, SOCK_DGRAM}