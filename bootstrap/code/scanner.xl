import core.Integer
import core.print
import core.String
import core.List
import core.Boolean
import core.range

enum TokenType {
    For, Class, Enum, Var, Import, If, Else, Start, EOF, Id, Special, OpenParen, CloseParen, OpenCurly, CloseCurly, Assign, Number, Semicolon, Colon, Comma, KwVar, KwFun
}

class Token {
    str: String
    type: TokenType
}

fun is_letter(c: String)->Boolean {
    return ["a", "b","c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z"].has(c)
}

fun char_in_string(c: String, s: String) -> Boolean {
    for i @ range(0, 1, s.len()) {
        if c == s[i] {
            return true
        }
    }
    return false
}

fun map_special(c: String)->TokenType{
    if c == "(" {
        return TokenType.OpenParen
    }
    if c == ")" {
        return TokenType.CloseParen
    }
    if c == "{" {
        return TokenType.OpenCurly
    }
    if c == "}" {
        return TokenType.CloseCurly
    }
    if c == "=" {
        return TokenType.Assign
    }
    if c == ";" {
        return TokenType.Semicolon
    }
    if c == ":" {
        return TokenType.Colon
    }
    if c == "," {
        return TokenType.Comma
    }
    return TokenType.Id
}

fun map_keyword(c: String)->TokenType{
    if c == "var" {
        return TokenType.KwVar
    }
    if c == "fun" {
        return TokenType.KwFun
    }
    return TokenType.Id
}

fun map_token_to_string(tok: TokenType) -> String {
    if tok == TokenType.OpenParen {
        return "OpenParen"
    }
    if tok == TokenType.CloseParen {
        return "CloseParen"
    }
    if tok == TokenType.OpenCurly {
        return "OpenCurly"
    }
    if tok == TokenType.CloseCurly {
        return "CloseCurly"
    }
    if tok == TokenType.Assign {
        return "Assign"
    }
    if tok == TokenType.Semicolon {
        return "Semicolon"
    }
    if tok == TokenType.Id {
        return "Id"
    }
    if tok == TokenType.Assign {
        return "Assign"
    }
    if tok == TokenType.Number {
        return "Number"
    }
    if tok == TokenType.Colon {
        return "Colon"
    }
    if tok == TokenType.Comma {
        return "Comma"
    }
    if tok == TokenType.KwVar {
        return "KwVar"
    }
    if tok == TokenType.KwFun {
        return "KwFun"
    }
    return "Unknown"
}

class Scanner {
    text: String
    cursor: Integer
    c: String
    tokens: List[Token]
    token: Token
    static fun init(text: String)->Scanner {
        return #Scanner(text, 0-1, "", []::Token, #Token("",TokenType.Start))
    }
    fun advance()->Integer{
        this.cursor = this.cursor + 1
        if this.cursor >= this.text.len() {
            return 0
        }
        this.c = this.text[this.cursor]
        return 0
    }
    fun skip_spaces()->Integer{
        while this.c == " " {
            _ = this.advance()
        }
        return 0
    }
    fun scan() -> Integer {
        _ = this.advance()
        while this.cursor < this.text.len() {
            _ = this.skip_spaces()
            if is_letter(this.c) {
                _ = this.scan_id_or_kw()
            } elif (char_in_string(this.c, "(){}=;,:")) {
                this.token = #Token(this.c,map_special(this.c))
                _ = this.advance()
            } elif (char_in_string(this.c, "1234567890")){
                _ = this.scan_number()
            }
            else {
                print("Don't know what to do with character '" + this.c + "'")
                return 1
            }
            this.tokens.push(this.token)
            print(this.token.str)
        }
        return 0
    }
    fun scan_number()->Integer{
        var s = this.c
        _ = this.advance()
        while char_in_string(this.c, "1234567890") {
            s += this.c
            _ = this.advance()
        }
        this.token = #Token(s, TokenType.Number)
        return 0
    }
    fun scan_id_or_kw() -> Integer {
        var s = this.c
        _ = this.advance()
        while is_letter(this.c) {
            s += this.c
            _ = this.advance()
        }
        var token_type = map_keyword(s)
        print("SCANNED " + s + " " + map_token_to_string(token_type))
        this.token = #Token(s, token_type)
        return 0
    }
}
