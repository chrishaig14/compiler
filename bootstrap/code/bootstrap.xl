import core.Integer
import core.print
import core.String
import core.List
import core.Boolean
import core.range
import scanner.Scanner
import scanner.map_token_to_string
import scanner.Token
import scanner.TokenType

class FunctionNode {
    id: String
    parameters: List[String]
}

class Parser {
    tokens: List[Token]
    token: Token
    fun expect(type: TokenType) -> Boolean {
        if this.token.type == type {
            return true
        }
        return false
    }
    fun parse_function()-> FunctionNode {
        var x = this.expect(TokenType.Id)
        var n = #FunctionNode("", []::String)
        return n
    }
}

fun main()->Integer{
    var code = "fun main()integer{var x = 2;}"
    var scanner = Scanner.init(code)
    var r = scanner.scan()
    var t = scanner.tokens
    for tok @ t {
        print(map_token_to_string(tok.type))
    }
    var parser = #Parser(scanner.tokens, #Token("",TokenType.Id))
    var function_node = parser.parse_function()
    print(function_node.id)
    return 0
}