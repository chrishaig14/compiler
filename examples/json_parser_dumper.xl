class JsonNull {
    i: Integer
}

class Json {
    root: Union[Boolean, String, Integer, Dict[String, Json], List[Json], JsonNull]
    static fun null()->Json {
        return #Json(#JsonNull(0))
    }
    fun boolean() -> Boolean {
        match this.root {
            b: Boolean {
                return b
            }
        }
        print("json is not a boolean")
        exit(1)
        return false
    }
    fun string() -> String {
        match this.root {
            s: String {
                return s
            }
        }
        print("json is not a string")
        exit(1)
        return ""
    }
    fun is_null() -> Boolean {
        match this.root {
            n: JsonNull {
                return true
            }
        }
        return false
    }
    fun integer() -> Integer {

        match this.root {
            i: Integer {
                return i
            }
        }
        print("json is not an integer")
        exit(1)
        return 0
    }
    fun list() -> List[Json] {
        match this.root {
            l: List[Json] {
                return l
            }
        }
        print("json is not an integer")
        exit(1)
        return []::Json
    }
    fun object() -> Dict[String, Json] {
        match this.root {
            d: Dict[String,Json] {
                return d
            }
        }
        print("json is not a dict")
        exit(1)
        return {}::[String, Json]
    }
}

class Result {
    j: Json
    r: String
}

class JsonParser {
    s: String
    i: Integer
    c: String
    fun next() {
        this.i = this.i + 1
        if this.i < this.s.len() {
            this.c = this.s[this.i]
        }
    }
    fun json_parse_string() -> String {
        var str = ""
        var ok = false
        this.next()
        while this.i < this.s.len() {
            if this.c == "\"" {
    //            string end
                this.next()
                ok = true
                break
            }
            str += this.c
            this.next()
        }
        if ok {
            return str
        }
        print("Bad json string: " + this.s)
        exit(1)
        return ""
    }

    fun json_parse_integer()->Integer {
        var str = this.c
        this.next()
        while this.i < this.s.len() {
            if "0123456789".find_first(this.c) == 0-1 {
                var r = Integer.parse(str)
                return r
            }
            str += this.c
            this.next()
        }
        var r = Integer.parse(str)
        return r
    }

    fun json_parse_object() -> Dict[String, Json] {
        var object = {}::[String, Json]
        var another = true
        this.next()
        while this.i < this.s.len() {
            if not another {
                if this.c == "}" {
                    this.next()
                    return object
                } else {
                    print("Error")
                    exit(1)
                }
            }
            if this.c != " " and this.c != "\"" {
                print("error invalid character >>>" + this.c + "<<<")
                exit(1)
            }
            var key_json = this.json_parse_string()
            var key = key_json

            if this.c != ":" {
                print("expected : here, got: " + this.c)
                exit(1)
            }
            this.next()
            var r = this.json_parse()
            object[key] = r
            another = this.c == ","
            if another {
    //            read comma and advance
                this.next()
            }
        }
        print("error!!!")
        exit(1)
        return {}::[String,Json]
    }

    fun json_parse_list() -> List[Json] {
        var l = []::Json
        var another = true
        this.next()
        while this.i <  this.s.len() {
            if not another and this.c != "]" {
                print("error expected end of list, got " + this.c)
                exit(1)
            } elif not another and this.c == "]" {
                this.next()
                return l
            }
            var r = this.json_parse()
            l.push(r)
            another = this.c == ","
            if another {
                this.next()
            }
        }
        return l
    }

    fun json_parse() -> Json {
        if this.c == "\"" {
    //        string start
            return #Json(this.json_parse_string())
        }
        if "0123456789".find_first(this.c) != 0-1 {
            // its a number
            return #Json(this.json_parse_integer())
        }
        if this.c == "{" {
            return #Json(this.json_parse_object())
        }
        if this.c == "[" {
            return #Json(this.json_parse_list())
        }
        return Json.null()
    }
    fun json_parse_top_level() -> Json {
        this.next()
        var j = this.json_parse()
        if this.i < this.s.len() {
            print("theres more string after parsed json: " + this.c)
            exit(1)
        }
        return j
    }
    static fun parse(s: String) -> Json {
        var parser = #JsonParser(s, 0-1,"")
        return parser.json_parse_top_level()
    }
}



fun json_dumps(j: Json) -> String {
    match j.root {
        s: String {
            return "\"" + s + "\""
        }
        i: Integer {
            return i.str()
        }
        b: Boolean {
            return b.str()
        }
        n: JsonNull {
            return "null"
        }
        l: List[Json] {
            var s = "["
            for e @ l {
                s += json_dumps(e) + ", "
            }
            if l.len() != 0 {
                s = s.slice(0,s.len()-2)
            }
            s += "]"
            return s
        }
        d: Dict[String, Json] {
            var s = "{"
            var keys = d.keys()
            for k @ keys {
                s += "\"" + k + "\"" + ":" + json_dumps(d[k]) + ", "
            }
            if keys.len() != 0 {
                s = s.slice(0, s.len()-2)
            }
            s += "}"
            return s
        }
    }
    print("Dont know how to dump a dict!")
    exit(1)
    return ""
}

fun main()->Integer {
    var s = "{\"abc\":123131,\"michael\":23,\"jackson\":123,\"ls\":[1,\"hello\",[23,54,{\"name\":\"peter\",\"age\":23}]]}"
    var j = JsonParser.parse(s)
    print("dumps:" + json_dumps(j))
    return 0
}