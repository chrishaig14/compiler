import core.core.print
import core.core.Integer
import core.core.List
import core.core.Boolean
import core.core.Dict
import core.core.String
import core.core.range
import core.file.File
import core.socket.Socket
import core.socket.SocketDomain
import core.socket.SocketType
import core.core.exit
import core.core.sleep
import core.threads.Thread

enum HttpMethod {
    GET, POST
}

class HttpRequest {
    method: HttpMethod
    url: String
    headers: Dict[String, String]
}

class HttpHeader {
    name: String
    value: String
}

fun parse_header(s: String) -> HttpHeader {
    var colon_pos = s.find_first(":")
    var header = s.slice(0, colon_pos)
    var value = s.slice(colon_pos + 1, s.len())
    return #HttpHeader(header, value)
}

fun handle_client(client_socket: Socket )->Integer{
    var BUFFER_SIZE = 32
    var msg = client_socket.recv(BUFFER_SIZE)
//    print("received message: " + msg)
    var headers = {}::[String,String]

    while msg.find_first("\n") == 0-1 {
        msg += client_socket.recv(BUFFER_SIZE)
//        print("reading again: " + msg)
    }
    var first_line = msg
    var head_end = msg.find_first("\n")
    var head = msg.slice(0, head_end-1)

    var rest = msg.slice(head_end+1, msg.len())

    while rest.find_first("\n") == 0-1 {
        rest += client_socket.recv(BUFFER_SIZE)
//        print("reading again: " + rest)
    }
    var end = rest.find_first("\n")
    var line = rest.slice(0, end-1)
    rest = rest.slice(end+1, rest.len())
    while line != "" {
        var header = parse_header(line)
//        print("HEADER: " + header[0] +  ":" + header[1])
        headers[header.name] = header.value

        while rest.find_first("\n") == 0-1 {
            rest += client_socket.recv(BUFFER_SIZE)
//            print("reading again: " + rest)
        }
        end = rest.find_first("\n")
//        print("end is: " + end.str())
        line = rest.slice(0, end-1)
//        print("line here: XX" + line + "ZZZZZZzzz")
        rest = rest.slice(end+1, rest.len())
    }

    if headers.has("Content-Length") {
        var content_length = Integer.parse(headers["Content-Length"])
    //    print("Expecting content-length: " + content_length.str())
    //    print("rest before: " + rest)
        while rest.len() < content_length {
            rest += client_socket.recv(BUFFER_SIZE)
        }
    }
//    print("rest: ")
//    print(rest)
    print("Got request: " + first_line.slice(0,first_line.find_first("\n")))
    sleep(10)
    print("ready to send response")
    var n = client_socket.send("HTTP/1.1 204 No-Content\n\n")
    return 0
}

fun main()->Integer {
    var sock = Socket.new(SocketDomain.AF_INET,SocketType.SOCK_STREAM)

    var port = 8080
    var ok = sock.bind(port)
    while not ok {
        print("Trying port " + port.str())
        port += 1
        ok = sock.bind(port)
    }

    print("Bound to port " + port.str())
    sock.listen(5)
    while true {
        var client_socket = sock.accept()
        var f = $handle_client(client_socket)
        var thread = Thread.new(f)
        thread.start()
    }
    return 0
}