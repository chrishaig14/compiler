fun parse_header(s: String) -> List[String] {
    var colon_pos = s.find_first(":")
    var header = s.slice(0, colon_pos)
    var value = s.slice(colon_pos + 1, s.len())
    return [header, value]
}

class Json {
    root: Union[String, Integer, Dict[String, Json]]
    fun get_string() -> String {
        var r = this.root
        match r {
            s: String {
                return s
            }
            i: Integer {
                exit(1)
            }
            d: Dict[String,Json] {
                exit(1)
            }
        }
        print("json is not a string")
        exit(1)
        return ""
    }
    fun get_integer() -> Integer {
        var r = this.root
        match r {
            s: String {
                exit(1)
            }
            i: Integer {
                return i
            }
            d: Dict[String,Json] {
                exit(1)
            }
        }
        print("json is not an integer")
        exit(1)
        return 0
    }
    fun get_dict() -> Dict[String, Json] {
        var r = this.root
        match r {
            s: String {
                exit(1)
            }
        }

        match r {
            s: String {
                exit(1)
            }
            i: Integer {
                exit(1)
            }
            d: Dict[String,Json] {
                return d
            }
        }
        print("json is not a dict")
        exit(1)
        return {}::[String, Json]
    }
}


















